# Copy this file to  .streamlit/secrets.toml  (locally) or paste into the
# "Secrets" box of Streamlit Community Cloud before deploying.
#
# Owner key that unlocks the "Analytics (owner)" view. Change it to something
# only you know. If unset, the app falls back to the local demo key "agritrue-demo".
OWNER_KEY = "change-me-to-something-private"
